# --- Database (Neon pooled connection — used by the app at runtime) ---
DATABASE_URL="postgresql://<user>:<password>@<project>-pooler.<region>.aws.neon.tech/<db>?sslmode=require"

# --- Database (Neon direct/unpooled connection — used only by `prisma migrate`) ---
# Must match the variable name schema.prisma's `directUrl` reads: DATABASE_URL_UNPOOLED.
DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@<project>.<region>.aws.neon.tech/<db>?sslmode=require"

# --- NextAuth ---
NEXTAUTH_URL="https://your-domain.com"
NEXTAUTH_SECRET="generate with: openssl rand -base64 32"

# --- Object storage (Cloudflare R2 shown; any S3-compatible works) ---
STORAGE_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET="ineedposn-uploads"
STORAGE_PUBLIC_URL="https://cdn.ineedposn.com"

# --- Email ---
# Sender shown on outgoing mail. For Gmail SMTP this MUST be the SMTP_USER address.
EMAIL_FROM="INeedBio <notify@ineedbio.shop>"
ADMIN_NOTIFICATION_EMAIL="admin@ineedbio.shop"

# Transport A — Resend (used when SMTP_* below is not set). Needs a verified domain.
RESEND_API_KEY=""

# Transport B — SMTP (Gmail: create an App Password at myaccount.google.com/apppasswords).
# When all three are set, SMTP is used instead of Resend.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""

# --- PromptPay ---
# Your registered PromptPay ID (phone number or tax ID), digits only
PROMPTPAY_ID="0812345678"
