# --- Database (Neon) ---
# Pooled connection, used by the site at runtime
DATABASE_URL="postgresql://<user>:<password>@<project>-pooler.<region>.aws.neon.tech/<db>?sslmode=require"
# Direct connection, used only by `prisma migrate deploy` during the Vercel build
DATABASE_URL_UNPOOLED="postgresql://<user>:<password>@<project>.<region>.aws.neon.tech/<db>?sslmode=require"

# --- Email (OTP, slip decisions, new-request alerts) ---
# Sender shown on outgoing mail. For Gmail SMTP this MUST be the SMTP_USER address.
EMAIL_FROM="INeedBio <ineedbio1803@gmail.com>"
# Gmail: create an App Password at myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# Or Resend instead of SMTP (needs a verified domain)
RESEND_API_KEY=""
# Daily sending limit shown in หลังบ้าน (Gmail: 500)
MAIL_DAILY_QUOTA="500"

# --- Optional ---
# Default PromptPay number until one is set in หลังบ้าน → ตั้งค่า
PROMPTPAY_ID=""
# Receives "new enrollment request" emails until หลังบ้าน → ตั้งค่า → admin_emails is set
ADMIN_NOTIFICATION_EMAIL=""
# Only to go back to the Google Apps Script backend: its Web App URL ending in /exec
# NEXT_PUBLIC_INEEDBIO_API_URL=""
