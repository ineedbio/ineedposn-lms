# --- Database (Supabase pooled connection — for the app itself) ---
DATABASE_URL="postgresql://postgres.xxxxx:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# --- Database (Supabase direct connection — used only for prisma db push/migrate) ---
DIRECT_URL="postgresql://postgres.xxxxx:[YOUR-PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres"

# --- NextAuth ---
NEXTAUTH_URL="https://your-domain.com"
NEXTAUTH_SECRET="generate with: openssl rand -base64 32"

# --- Object storage (Cloudflare R2 shown; any S3-compatible works) ---
STORAGE_ENDPOINT="https://<accountid>.r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET="ineedposn-uploads"
STORAGE_PUBLIC_URL="https://cdn.ineedposn.com"

# --- Email (Resend) ---
RESEND_API_KEY=""
EMAIL_FROM="INeedPOSN <notify@ineedposn.com>"
ADMIN_NOTIFICATION_EMAIL="admin@ineedposn.com"

# --- PromptPay ---
# Your registered PromptPay ID (phone number or tax ID), digits only
PROMPTPAY_ID="0812345678"
